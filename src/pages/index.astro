---
import Base from '../layouts/Base.astro';
import CategoryStrip from '../components/CategoryStrip.astro';
import ManufacturerCard from '../components/ManufacturerCard.astro';
import { getAllManufacturers } from '../lib/manufacturers';

const profiles = getAllManufacturers();
const countLabel =
  profiles.length === 1 ? '1 manufacturer on the list.' : `${profiles.length} manufacturers on the list.`;
---

<Base
  description="A list of manufacturers, with shelves for what they make. Each card shows who owns the company, where the work happens, and a sourced American rating."
>
  <div class="page-intro">
    <p class="eyebrow">The list</p>
    <h1>Manufacturers</h1>
    <p class="lede">Our mission is to investigate, verify and feature companies who hold themselves to an American made standard.</p>
    <p class="lede">Who makes it, who owns the company, and where the work happens.</p>
    <p class="page-intro__meta">{countLabel}</p>
    <p class="page-intro__meta">
      <a href="/submit/review">Request a review</a>
      <span aria-hidden="true"> · </span>
      <a href="/submit/company">Suggest a company</a>
    </p>
  </div>

  <CategoryStrip />

  {
    profiles.length === 0 ? (
      <p class="prose">No manufacturers are filed yet.</p>
    ) : (
      <div class="card-grid" id="list">
        {profiles.map((profile) => (
          <ManufacturerCard profile={profile} />
        ))}
      </div>
    )
  }

  <details class="fold">
    <summary>How a record is written</summary>
    <div class="stack">
      <p>
        The two lines on a card are separate. A plant in the United States does not make a foreign parent American. A U.S. owner does not make an overseas factory domestic.
      </p>
      <p>
        A company is added as a JSON file in this repository. Factual sentences carry sources. If a document is missing, or two accounts disagree, the profile says so.
      </p>
      <p>
        A review or a proposed edit can be sent from a manufacturer page, or from <a href="/submit">the corrections page</a>. A request to review a company that is already operating goes to <a href="/submit/review">Request a review</a>. A manufacturer that is not on the list goes to <a href="/submit/company">Suggest a company</a>. Each one waits in a queue. None of them is written into a file from the form.
      </p>
      <p>
        When the sources support it, an American-founded, American-owned, American-run company can also carry a short note that the shop is heavily automated. The note does not change that company’s place on the list. The number on a card is three sourced lines. Automation is shown on that number and worth zero.
      </p>
      <p>
        <a href="/how-we-rate">How the number is built</a>
      </p>
    </div>
  </details>
</Base>
