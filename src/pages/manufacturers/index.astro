---
import Base from '../../layouts/Base.astro';
import ManufacturerCard from '../../components/ManufacturerCard.astro';
import { getAllManufacturers } from '../../lib/manufacturers';

const profiles = getAllManufacturers();
---

<Base
  title="Manufacturers"
  description="Alphabetical list of manufacturers. Each record separates who owns and runs the company from where the manufacturing happens."
>
  <p class="crumb">
    <a href="/">Home</a>
    <span aria-hidden="true"> / </span>
    <span>Manufacturers</span>
  </p>
  <div class="page-intro">
    <p class="eyebrow">Index</p>
    <h1>Manufacturers</h1>
    <p class="lede">The same companies as on the front page, in alphabetical order. The rating does not change that order.</p>
  </div>

  {
    profiles.length === 0 ? (
      <p class="prose">No manufacturers are filed yet.</p>
    ) : (
      <div class="card-grid" id="list">
        {profiles.map((profile) => (
          <ManufacturerCard profile={profile} />
        ))}
      </div>
    )
  }
</Base>
