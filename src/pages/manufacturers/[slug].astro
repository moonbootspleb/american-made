---
import Base from '../../layouts/Base.astro';
import ManufacturerProfile from '../../components/ManufacturerProfile.astro';
import { getAllManufacturers, placeLine, type Manufacturer } from '../../lib/manufacturers';

export function getStaticPaths() {
  return getAllManufacturers().map((profile) => ({
    params: { slug: profile.slug },
    props: { profile },
  }));
}

interface Props {
  profile: Manufacturer;
}

const { profile } = Astro.props;
const description = `${profile.name}, ${profile.legalName} in ${placeLine(profile)}. ${profile.products.map((product) => product.name).join(', ')}. Ownership, plant, inputs, and a sourced American rating.`;
---

<Base title={profile.name} description={description}>
  <ManufacturerProfile profile={profile} />
</Base>
