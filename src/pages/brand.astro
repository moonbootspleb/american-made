---
import Base from '../layouts/Base.astro';

const candidates = [
  { src: '/brand/brand-shield-cleanup.png', label: 'Shield cleanup' },
  { src: '/brand/brand-shield-fill-wrap.png', label: 'Boots restart fill-wrap' },
  { src: '/brand/brand-boots-restart-source.png', label: 'Boots restart source' },
];

const earlier = [
  { src: '/brand/brand-favicon-clean.png', label: 'Favicon-clean' },
  { src: '/brand/brand-compact-arc.png', label: 'Compact arc' },
  { src: '/brand/brand-hammer-strike.png', label: 'Hammer strike' },
];
---

<Base
  title="Brand marks"
  description="Review only. No mark is locked, and the header is unchanged."
  noindex
>
  <div class="page-intro">
    <h1>Brand marks</h1>
    <p class="lede">Review only. No mark is locked, and the header is unchanged.</p>
  </div>
  <ul class="mark-list">
    {
      candidates.map((mark) => (
        <li>
          <p class="kicker">{mark.label}</p>
          <img src={mark.src} alt={mark.label} width="1280" height="720" />
        </li>
      ))
    }
  </ul>
  <h2 class="earlier-heading">Earlier</h2>
  <ul class="mark-list">
    {
      earlier.map((mark) => (
        <li>
          <p class="kicker">{mark.label}</p>
          <img src={mark.src} alt={mark.label} width="1280" height="720" />
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .mark-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .earlier-heading {
    margin: 2rem 0 0.75rem;
    font-size: 1.15rem;
  }

  .mark-list li {
    background: var(--paper-raised);
    border: 1px solid #b7b0a4;
    padding: 0.9rem 1rem 1rem;
  }

  .mark-list img {
    display: block;
    width: min(100%, 640px);
    height: auto;
    margin-top: 0.65rem;
    background: #fff;
  }
</style>
