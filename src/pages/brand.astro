---
import Base from '../layouts/Base.astro';

const candidates = [
  {
    src: '/brand/mark-boots-grok-imagine.jpg',
    label: 'Develop header mark — Boots Grok Imagine target (2026-09-28), stripes to shield bottom, no wispy pixels',
    width: 1792,
    height: 1008,
  },
  { src: '/brand/brand-shield-cleanup.png', label: 'Shield cleanup', width: 1280, height: 720 },
  { src: '/brand/brand-shield-fill-wrap.png', label: 'Boots restart fill-wrap', width: 1280, height: 720 },
  { src: '/brand/brand-boots-restart-source.png', label: 'Boots restart source', width: 1280, height: 720 },
];

const earlier = [
  { src: '/brand/brand-favicon-clean.png', label: 'Favicon-clean', width: 1280, height: 720 },
  { src: '/brand/brand-compact-arc.png', label: 'Compact arc', width: 1280, height: 720 },
  { src: '/brand/brand-hammer-strike.png', label: 'Hammer strike', width: 1280, height: 720 },
];
---

<Base
  title="Brand marks"
  description="The develop header uses the Boots Grok Imagine mark."
  noindex
>
  <div class="page-intro">
    <h1>Brand marks</h1>
    <p class="lede">The develop header uses the Boots Grok Imagine mark. It is not on production.</p>
  </div>
  <ul class="mark-list">
    {
      candidates.map((mark) => (
        <li>
          <p class="kicker">{mark.label}</p>
          <img src={mark.src} alt={mark.label} width={mark.width} height={mark.height} />
        </li>
      ))
    }
  </ul>
  <h2 class="earlier-heading">Earlier</h2>
  <ul class="mark-list">
    {
      earlier.map((mark) => (
        <li>
          <p class="kicker">{mark.label}</p>
          <img src={mark.src} alt={mark.label} width={mark.width} height={mark.height} />
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .mark-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .earlier-heading {
    margin: 2rem 0 0.75rem;
    font-size: 1.15rem;
  }

  .mark-list li {
    background: var(--paper-raised);
    border: 1px solid #b7b0a4;
    padding: 0.9rem 1rem 1rem;
  }

  .mark-list img {
    display: block;
    width: min(100%, 640px);
    height: auto;
    margin-top: 0.65rem;
    background: #fff;
  }
</style>
