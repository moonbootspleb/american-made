---
import AutomationNote from './AutomationNote.astro';
import StatusBadges from './StatusBadges.astro';
import { placeLine, type Manufacturer } from '../lib/manufacturers';

interface Props {
  profile: Manufacturer;
}

const { profile } = Astro.props;
---

<a class="card" href={`/manufacturers/${profile.slug}`}>
  <div class="card__top">
    <p class="eyebrow">{profile.category}</p>
    <p class="eyebrow">{placeLine(profile)}</p>
  </div>
  <h2>{profile.name}</h2>
  <p class="quiet" style="margin:0">{profile.legalName}</p>
  <StatusBadges ownership={profile.ownership} manufacturing={profile.manufacturing} />
  <p class="deck" style="margin:0">{profile.deck}</p>
  {
    profile.automation?.heavilyAutomated && (
      <AutomationNote label={profile.automation.label} note={profile.automation.note} />
    )
  }
  <p class="card__open">Read the profile</p>
</a>
