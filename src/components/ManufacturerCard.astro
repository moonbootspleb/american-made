---
import AutomationNote from './AutomationNote.astro';
import CompanyLink from './CompanyLink.astro';
import RatingBreakdown from './RatingBreakdown.astro';
import StatusBadges from './StatusBadges.astro';
import { categoryNameList, placeLine, type Manufacturer } from '../lib/manufacturers';

interface Props {
  profile: Manufacturer;
}

const { profile } = Astro.props;
const products = profile.products.map((product) => product.name).join(', ');
---

<article class="card">
  <a class="card__main" href={`/manufacturers/${profile.slug}`}>
    <img
      class="maker-logo"
      src={profile.logo.src}
      alt={profile.logo.alt}
      width={profile.logo.width}
      height={profile.logo.height}
    />
    <div class="card__top">
      <p class="eyebrow">{categoryNameList(profile)}</p>
      <p class="eyebrow">{placeLine(profile)}</p>
    </div>
    <h2>{profile.name}</h2>
    <p class="quiet" style="margin:0">{profile.legalName}</p>
    <p class="product-line">{products}</p>
    <RatingBreakdown profile={profile} />
    <StatusBadges ownership={profile.ownership} manufacturing={profile.manufacturing} />
    <p class="deck" style="margin:0">{profile.deck}</p>
    {
      profile.automation?.heavilyAutomated && (
        <AutomationNote label={profile.automation.label} note={profile.automation.note} />
      )
    }
    <p class="card__open">Read the profile</p>
  </a>
  <div class="card__company">
    <CompanyLink profile={profile} />
  </div>
</article>
